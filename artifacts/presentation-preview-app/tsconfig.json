{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "../..",
    "paths": {
      "@/components/auth-provider": [
        "src/components/presentation-preview/demo-adapter.tsx"
      ],
      "@/components/prototype-provider": [
        "src/components/presentation-preview/demo-adapter.tsx"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "node_modules/.cache/next-preview/types/**/*.ts",
    "node_modules/.cache/next-preview/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
